<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Every API host compiles dynamic code; PGO instrumentation of it costs far more CPU than the tiering it buys in short-lived test hosts. -->
    <TieredPGO>false</TieredPGO>
    <AgentPlatform Condition="'$(AgentPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</AgentPlatform>
    <TargetFramework Condition="'$(AgentPlatform)' == 'Windows'">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The isolated SMTP/HTTPS servers and fakes are shared with the notification unit tests. -->
    <Compile Include="../unit-tests/Notifications/Support/*.cs" Link="Notifications/Support/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/infrastructure/BackupPlatform.Infrastructure.csproj" />
    <!-- Aliased: the Agent.Core namespace would otherwise shadow the Agent domain entity in this project. -->
    <ProjectReference Include="../../src/agent/core/BackupPlatform.Agent.Core.csproj" Aliases="AgentCore" />
    <ProjectReference Include="../../src/agent/transport/BackupPlatform.Agent.Transport.csproj" Aliases="AgentTransport" />
    <ProjectReference Include="../../src/hosts/agent/BackupPlatform.Agent.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/hosts/api/BackupPlatform.Api.csproj" />
    <ProjectReference Include="../../src/providers/backup/abstractions/BackupPlatform.BackupProviders.Abstractions.csproj" />
    <ProjectReference Include="../../src/providers/backup/mssql/BackupPlatform.BackupProviders.MSSQL.csproj" />
    <ProjectReference Include="../../src/providers/backup/postgresql/BackupPlatform.BackupProviders.PostgreSql.csproj" />
    <ProjectReference Include="../../src/providers/storage/abstractions/BackupPlatform.StorageProviders.Abstractions.csproj" />
    <ProjectReference Include="../../src/providers/storage/local/BackupPlatform.StorageProviders.Local.csproj" />
    <ProjectReference Include="../../src/providers/storage/central/BackupPlatform.StorageProviders.Central.csproj" />
    <ProjectReference Include="../../src/providers/storage/sftp/BackupPlatform.StorageProviders.Sftp.csproj" />
    <ProjectReference Include="../../src/providers/storage/google-drive/BackupPlatform.StorageProviders.GoogleDrive.csproj" />
    <ProjectReference Include="../../src/providers/storage/s3/BackupPlatform.StorageProviders.S3.csproj" />
    <ProjectReference Include="../../src/providers/storage/smb/BackupPlatform.StorageProviders.Smb.csproj" />
  </ItemGroup>

  <Target Name="CopyDirectDownloadHelper" AfterTargets="Build">
    <PropertyGroup>
      <DirectHelperName Condition="'$(AgentPlatform)' != 'Windows'">backup-direct-download</DirectHelperName>
      <DirectHelperName Condition="'$(AgentPlatform)' == 'Windows'">backup-direct-download.exe</DirectHelperName>
    </PropertyGroup>
    <Copy SourceFiles="../../src/hosts/agent/bin/$(Configuration)/$(TargetFramework)/$(DirectHelperName)" DestinationFolder="$(OutDir)" Condition="Exists('../../src/hosts/agent/bin/$(Configuration)/$(TargetFramework)/$(DirectHelperName)')" />
  </Target>

</Project>
# This file is an example only; .NET/EF tools do not automatically load dotenv files.
# Supply actual connection strings through environment variables or a local secret store.
# PostgreSQL form: Host=<host>;Port=<port>;Database=<database>;Username=<user>;Password=<secret>
# EF tools: dotnet tool restore
# Migration: dotnet ef database update --project src/core/infrastructure
# Integration: dotnet test tests/integration-tests -c Release -p:ContinuousIntegrationBuild=true
# Test connection requires CREATEDB; tests create/drop their own unique database, never the configured database.
# Browser control plane: GET /api/me includes isPlatformAdmin and actual membershipRole alongside the authorization-class role.
# Tenant Viewer reads /agents (including /{id}), /backup-jobs, /backup-runs, /backup-artifacts and /dashboard; mutations keep their existing operator/admin policies.
# Tenant Admin/Owner may GET/PUT /agent-enrollment {enabled}; /api/platform/... remains independently PlatformAdmin-only.
# Runs/artifacts history always returns {items,totalCount,page,pageSize}; page starts at 1, pageSize defaults to 25 (maximum 100).
# History filters: jobId,agentId,from,to (inclusive UTC createdAt), plus status/trigger for runs or state for artifacts.
# Operator PUT /backup-jobs/{id} is ONE atomic edit: name,agentId,configuration,retryPolicy,overlapPolicy plus optional schedule (or removeSchedule:true), enabled and
# (Owner/Admin only, otherwise 403 administrator_required) retention. Omitted members keep their value; everything is validated and committed in one transaction under the
# agent lock, so an invalid part changes nothing. Only future runs are affected. POST /backup-jobs accepts the same schedule/retention/enabled members in one request.
# The separate /schedule, /retention, /enable and /disable routes remain. The scheduler wake-up is synchronized after the commit; the periodic reconciliation repairs a failed sync.
# Agent capabilities: the heartbeat carries only capabilityRevision. An unknown or different revision makes the heartbeat answer capabilitySyncRequested=true and the agent
# calls PUT /api/agent/capabilities {revision,capabilities:[{identifier,support:Unknown|Supported|Unsupported,metadata?}]} (agent identity from the credential, revision must match
# the payload hash, duplicate syncs are idempotent). The snapshot is stored in agent_capabilities and shown by GET /agents and /agents/{id} as capabilities, capabilitiesRevision, capabilitiesReportedAt.
# Dashboard is one tenant-wide summary request; cancellation-requested runs remain nonterminal until the agent acknowledges.
BACKUP_PLATFORM_CONNECTION_STRING=
BACKUP_PLATFORM_TEST_CONNECTION_STRING=

# Explicit one-time bootstrap, after migrations:
# dotnet run --project src/hosts/api -- --bootstrap-user
# No defaults; command refuses once a password credential exists and never starts the HTTP listener.
# Login identifiers are 3..128 ASCII letters/digits/dot/underscore/hyphen; trimmed and case-insensitive.
# Bootstrap password must have 12..1024 characters. Supply all values through a secret store/environment.
BACKUP_PLATFORM_BOOTSTRAP_LOGIN=
BACKUP_PLATFORM_BOOTSTRAP_PASSWORD=
BACKUP_PLATFORM_BOOTSTRAP_DISPLAY_NAME=

# Browser API assumes same-origin frontend deployment over HTTPS. No auth tokens belong in browser storage.
# Fetch GET /api/auth/antiforgery before login; send its requestToken in X-CSRF-TOKEN for unsafe API methods.
# Fetch a new token after login because antiforgery tokens are bound to the authenticated identity.
# Production deployment must persist/protect ASP.NET Data Protection keys using an appropriate external key store.

# MSSQL integration tests (tests/integration-tests/MsSql) need a real SQL Server and FAIL when none is configured; they never skip.
# Docker is only one way to get a server; any native Windows/Linux instance reachable over TCP works.
# The login must be sysadmin: tests create/drop unique databases/logins, execute real backups, and clean their staged files.
#   docker run -d -e ACCEPT_EULA=Y -e MSSQL_SA_PASSWORD='<strong password>' -p 127.0.0.1:14333:1433 mcr.microsoft.com/mssql/server:2022-latest
BACKUP_PLATFORM_TEST_MSSQL_HOST=
BACKUP_PLATFORM_TEST_MSSQL_PORT=
BACKUP_PLATFORM_TEST_MSSQL_INSTANCE=
BACKUP_PLATFORM_TEST_MSSQL_USER=
BACKUP_PLATFORM_TEST_MSSQL_PASSWORD=
BACKUP_PLATFORM_TEST_MSSQL_TRUST_SERVER_CERTIFICATE=
# MSSQL: run only these tests with: dotnet test tests/integration-tests -c Release --filter "FullyQualifiedName~MsSql"

# SQL Server must be able to write its staging path; the agent must read/delete that same directory.
# Declare both paths explicitly, even when they are identical (SameHost).
BACKUP_PLATFORM_TEST_MSSQL_STAGING_SERVER_DIR=
BACKUP_PLATFORM_TEST_MSSQL_STAGING_AGENT_DIR=
BACKUP_PLATFORM_TEST_MSSQL_UNWRITABLE_SERVER_DIR=

# Manual backup vertical slice: POST /api/tenants/{tenantId}/backup-jobs
# Body: {name,agentId,configuration:{engine:"mssql",database,host,port,integratedSecurity,
# databaseCredentialReference,encrypt,trustServerCertificate,stagingReference:"default",
# storageProvider:"local"|"central",storageExecutionLocation:"Backend"|"Agent",storagePrefix,copyOnly,checksumPolicy,compressionPolicy}}.
# Option policies: Required / Preferred / Disabled. Runs are Full backups started manually or by a schedule (see "Scheduled backups" below).
# Admin/Operator may POST /backup-jobs/{jobId}/runs with Idempotency-Key (1..128 printable non-space ASCII).
# The same tenant/job/key returns the same logical run, including after completion; a new key starts a new run (or is refused under Skip).
# Viewer may GET /backup-runs and /backup-runs/{runId}. Browser writes also require the antiforgery header above.
# POST /backup-runs/{runId}/cancel immediately cancels Pending work; a running/leased response has
# cancellationRequestedAt and does NOT promise physical completion. Agent lease renewal delivers the request.
# Lifecycle: Pending -> Leased -> Running -> Succeeded/Failed/Cancelled; an expired lease ends the attempt as AgentLost.
# Polling claims work atomically; SignalR only sends best-effort hints. Concurrency never depends on SignalR or process memory.
# Lease 120s, agent renews every 10s, progress coalesces every 2s, stale detector runs every 15s.

# Retry: 1 logical execution = 1 BackupRun; a retry is a NEW attempt (numbers 1,2,3,...) on the SAME run, never a new run.
# Job body may add retryPolicy:{maxAttempts (TOTAL attempts, default 3, 1..10),initialDelaySeconds (30),maxDelaySeconds (600),
# backoff:"Exponential"|"Fixed",jitter (0..1, default 0.2, only shortens delays)} and overlapPolicy:"Skip"|"Queue" (default Skip).
# Retryable failures (agent-lost, DatabaseUnavailable, OperationTimedOut, StorageUnavailable, ReplicaVerificationFailed) with attempts left
# put the run in RetryPending with nextAttemptAt (durable; a restart loses nothing); all other failures end the run Failed.
# POST /backup-runs/{runId}/retry (Admin/Operator): new attempt now; refused (409) for Succeeded, Cancelled, queued/running
# and attempts-exhausted runs. Cancel always wins over retry; cancelling a RetryPending run withdraws the retry.
# Skip: a manual start while the job has a queued/retrying/running run returns 409 overlap_skipped (nothing started); Queue enqueues.
# Idempotency-Key only de-duplicates a manual start; it never blocks or counts as a retry.
# Concurrency (backend policy, counted from Leased/Running attempts in the database): Backups__GlobalMaxConcurrentBackups (20),
# Backups__TenantMaxConcurrentBackups (5), Backups__TenantOverrides__<tenantId> (n), Backups__AgentMaxConcurrentBackups (1),
# Backups__RetryScanInterval (00:00:05). Agent.Host executes one backup at a time; raise the agent limit only for agents that parallelise.
# Backups__GlobalMaxConcurrentBackups=20
# Backups__TenantMaxConcurrentBackups=5
# Backups__AgentMaxConcurrentBackups=1
# Backups__RetryScanInterval=00:00:05

# Scheduled backups. The database is the source of truth; Quartz.NET (PostgreSQL job store, schema "quartz", clustered) only WAKES the backend
# at the next occurrence and never decides anything. Provisioning: the QuartzSchedulerStore EF migration creates the quartz.* tables
# (Quartz's official 4.3.0 script, embedded and idempotent); run `dotnet ef database update` as for every other table, nothing else is needed.
# Job body / PUT /backup-jobs/{jobId}/schedule take: schedule:{enabled (true), cronExpression (5 fields: minute hour day-of-month month day-of-week),
# timeZone (IANA id such as Europe/Istanbul or UTC; always explicit, the server zone is never used), missedRunGraceSeconds (60..604800, default 1800),
# overlapPolicy:"Skip"|"Queue" (same field as the job's)}. DELETE .../schedule makes the job on-demand only; POST .../enable and .../disable
# switch the whole job (a disabled job starts nothing, manual or scheduled; re-enabling never catches up the time it was off).
# Invalid input is HTTP 400 {error:"invalid_schedule",field,code,message} with code invalid_cron | invalid_time_zone | invalid_grace.
# The job's read model shows schedule.{enabled,cronExpression,timeZone,missedRunGraceSeconds,overlapPolicy,nextOccurrenceAt (UTC)}.
# GET .../backup-jobs/{jobId}/schedule/occurrences (Viewer) explains every decided instant: RunCreated, SkippedOverlap (names the blocking run),
# MissedGraceExpired, MissedSuperseded, JobDisabled, each with a stable reason and the scheduling delay.
# Rules: of several instants that came due, only the LATEST is acted on and only within its grace (lateness == grace still runs); older ones are
# history, never a catch-up run, whatever the overlap policy. An offline or unseen agent (persisted last-seen vs Agents:Connectivity OfflineTimeout)
# defers the occurrence instead of creating a run nobody can claim; it runs once if the agent returns within grace, never after. Unclaimed scheduled
# runs are ended (Cancelled, ScheduleGraceExpired) once their grace is over. Skip: an active (queued, running or RetryPending) run of the job skips
# the occurrence; Queue queues one behind it. A retry attempt is part of its run (attempt trigger "Retry"), never an occurrence.
# Scheduled runs enter the normal Pending -> claim pipeline and obey the global, tenant and agent concurrency limits; Quartz never executes a backup.
# Idempotency: unique (tenant, job, scheduled instant) on both the occurrence record and the run, so nodes, refires, reconciliation and DST cannot duplicate.
# Backups__Scheduling__Enabled=true                       (false turns the wake-up scheduler and the sweep off on this node)
# Backups__Scheduling__ReconcileInterval=00:00:30         (sweep: starts due occurrences it missed, expires unclaimed runs, reconciles Quartz with the jobs)
# Backups__Scheduling__SweepBatchSize=200
# Backups__Scheduling__DefaultMissedRunGrace=00:30:00
# Backups__Scheduling__AllowSecondPrecisionCron=false     (development/tests only: also accepts a leading seconds field)
# MSSQL actual-host scheduling smoke (backend + Agent.Host + SQL Server + PostgreSQL):
#   dotnet test tests/integration-tests -c Release --filter "FullyQualifiedName~MsSqlScheduledAgentSmokeTests"

# Retention and cleanup. The BACKEND owns every deletion decision; the database (never process memory) decides what is due, so any number of
# backend nodes may run the workers. A job carries retention:{enabled (true), keepForSeconds (30 days), deleteGracePeriodSeconds (24 h)} (job body, and
# PUT /backup-jobs/{jobId}/retention, Admin only). Each run snapshots the job's policy when it is created; the artifact it publishes expires at
# acceptedAt + keepFor, where acceptedAt is the BACKEND clock when the completion was accepted (never run creation, attempt start or an agent-reported time).
# Editing the job later never moves the expiration of an existing backup (there is deliberately no bulk re-apply). enabled=false keeps backups forever.
# Lifecycle of a replica (one physical copy; an artifact can have several): Available -> DeletePending (soft delete: intact, visible, still usable, cancellable)
# -> Deleting (irreversible backend claim or durable agent dispatch) -> Deleted (provider delete AND absence verified) | DeleteFailed (stable failureCode).
# Retryable failures use bounded exponential backoff; agent configuration/namespace/target failures stop without an automatic retry. Already absent is success.
# Runs, attempts, artifacts and replicas are never removed from the database: a deleted replica keeps its location and checksum with status Deleted.
# Endpoints (tenant scoped; Viewer may read, only Owner/Admin may change): GET .../backup-artifacts[?jobId&limit], GET .../backup-artifacts/{id},
# DELETE .../backup-artifacts/{id} (202: starts the grace period, NEVER deletes physically; 409 already_deleted), POST .../backup-artifacts/{id}/cancel-delete
# (200 while the replicas are still DeletePending; 409 not_cancellable once deletion is claimed/dispatched; an artifact that had already expired is pinned so
# retention does not delete it again). Views show deletionExecutor (Backend/Agent), waitingForAgent, deleteFailureCode and deleteNextAttemptAt, never work ids/tokens.
# Backups__Retention__Enabled=true                        (false turns the retention/sweep/prune workers off on this node; the API stays available)
# Backups__Retention__ScanInterval=00:00:30
# Backups__Retention__DefaultKeepFor=30.00:00:00          Backups__Retention__DefaultDeleteGracePeriod=1.00:00:00
# Backups__Retention__MinimumKeepFor=01:00:00             Backups__Retention__MinimumDeleteGracePeriod=01:00:00   (platform minimums for API-supplied policies)
# Backups__Retention__DeleteLeaseDuration=00:10:00        Backups__Retention__DeleteRetryInitialDelay=00:01:00    Backups__Retention__DeleteRetryMaxDelay=01:00:00
# Backups__Retention__StorageSweepInterval=01:00:00       Backups__Retention__OrphanMinimumAge=06:00:00           Backups__Retention__PartialUploadMinimumAge=06:00:00
# Backups__Retention__ScheduleOccurrenceHistoryRetention=90.00:00:00   (decided schedule occurrences older than this are pruned; the newest per job is always kept)
# Physical executor is PERSISTED metadata, not inferred from a filesystem path or from whether a backend root happens to resolve.
# Job configuration.storageExecutionLocation defaults to Agent for local and Backend for central; explicit Backend supports backend-accessible local storage.
# Replica executor/owning agent come from the persisted run configuration and authenticated backup owner, never replica completion metadata.
# Migration AgentReplicaDeletion persists those defaults for existing jobs/runs/replicas and resolves local owners via artifact -> attempt -> run.
# Agent replicas remain Deleting/waitingForAgent with agent_unavailable and bounded next-check metadata while their owner is offline; no file is deleted by the backend.
# On reconnect the owning agent can claim immediately. DeleteReplica tasks share the authoritative poll but do not consume backup concurrency slots.
# A stable operation id and fresh per-claim token fence lease renewals/completions; backend node leases never own agent execution. Redelivery after a crash is safe.
# Wire task type is delete-replica: replicaId, tenantId, agentId, operationId, leaseToken, leaseExpiresAt, persisted local target/key and managed namespace ids/prefix.
# POST /api/agent/replica-deletions/{replicaId}/lease and /complete require Agent authentication and protocol. Exact duplicate completion is accepted; stale callbacks cannot mutate.
# Agent resolves only configured local/local through Agent__Backup__LocalStorage__RootDirectory, validates its own identity and managed namespace, then DeleteAsync -> ExistsAsync.
# Tasks carry no raw filesystem path. Provider root/symlink/traversal protections remain authoritative. Agent.Core depends on storage abstractions only.
# Storage the BACKEND may delete from (Backend replica with no configured storage becomes DeleteFailed/storage_not_configured; Agent replicas never use this resolver):
# Backups__Storage__Central__RootDirectory=/srv/backup-central   Backups__Storage__Central__TenantScopes__<tenantId>=<the TenantScope the agent uses>
# Backups__Storage__Local__RootDirectory=/mnt/backend-local      (requires persisted storageExecutionLocation:"Backend"; configuring a root alone never changes executor)
# Orphan sweep (conservative): only files of the managed layout [prefix/]tenant/job/run/attempt/Name_yyyyMMddTHHmmssZ_xxxxxxxx_FULL.bak whose attempt exists in the
# database, whose run is not active (Pending/Leased/Running/RetryPending), that no replica references and that are older than OrphanMinimumAge are deleted; abandoned
# uploads (.<name>.<guid>.partial) only when older than PartialUploadMinimumAge, not held open and of a run that is not active. Anything else in the storage is never touched.
# Agent staging cleanup (agent-local, separate from storage retention): Agent__Backup__Staging__Cleanup__Enabled=true, __MinimumAge=12:00:00, __ScanInterval=01:00:00.
# Only managed staged names (Name_yyyyMMddTHHmmssZ_xxxxxxxx_FULL.bak), older than MinimumAge, not used by a current attempt and not held open are removed; an operator's own .bak stays.
# Real retention smoke (HTTPS backend + published Agent.Host + SQL Server + PostgreSQL): backend-direct, agent-local with no backend root, and offline/restart.
#   dotnet test tests/integration-tests -c Release --filter "FullyQualifiedName~MsSqlRetentionAgentSmokeTests"
# Strict Release/CI build: dotnet build BackupPlatform.sln -c Release -p:ContinuousIntegrationBuild=true -warnaserror
# Full integration (configure real PostgreSQL/SQL/Agent.Host above): dotnet test tests/integration-tests -c Release --no-build -- xUnit.MaxParallelThreads=4
# Bound collection concurrency for shared database resources; race tests still run their own competing workers/polls.

# Agent deployment: roots must exist, staging must be writable by SQL Server and readable/deletable by the agent.
# Source credentials are resolved on demand through ISecretProvider; never put values in a job/task configuration.
# For databaseCredentialReference "sql_primary", inject BACKUP_AGENT_SECRET_sql_primary from the service manager:
# JSON shape: {"userName":"<sql login>","password":"<secret>"}. No app-level credential cache or persistence is used.
# Integrated authentication instead uses the actual agent process/service account and needs no credential reference.
BACKUP_AGENT_SECRET_sql_primary=
Agent__Backend__BaseUri=
Agent__CredentialStoreDirectory=
Agent__Backup__Staging__Mapping=
Agent__Backup__Staging__ServerDirectory=
Agent__Backup__Staging__AgentDirectory=
Agent__Backup__LocalStorage__RootDirectory=
Agent__Backup__CentralStorage__RootDirectory=
Agent__Backup__CentralStorage__TenantScope=

# Actual-host smoke (Linux identity store, real HTTPS API + PostgreSQL + SQL Server + published Linux Agent.Host):
# dotnet publish src/hosts/agent -c Release -r linux-x64 --self-contained true -p:AgentPlatform=Linux -o <publish>
# dotnet test tests/integration-tests -c Release --filter "FullyQualifiedName~MsSqlManualAgentSmokeTests"
# The optional launcher receives the host executable as its sole argument and inherits the deployment environment.
# It must preserve the scratch path BACKUP_PLATFORM_AGENT_SMOKE_SCRATCH and forward termination to Agent.Host.
# Use a launcher when the declared SQL volume must be mounted into the actual agent runtime; tests never discover Docker.
# The test's self-signed backend certificate is trusted only by that child through SSL_CERT_FILE, not the system trust store.
BACKUP_PLATFORM_TEST_AGENT_HOST_PATH=
BACKUP_PLATFORM_TEST_AGENT_HOST_LAUNCHER=

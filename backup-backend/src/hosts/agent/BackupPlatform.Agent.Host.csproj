<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AgentPlatform Condition="'$(AgentPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</AgentPlatform>
    <AgentPlatform Condition="'$(AgentPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</AgentPlatform>
    <TargetFramework Condition="'$(AgentPlatform)' == 'Windows'">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AgentPlatform)' == 'Windows'">
    <DefineConstants>$(DefineConstants);AGENT_PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AgentPlatform)' == 'Linux'">
    <DefineConstants>$(DefineConstants);AGENT_PLATFORM_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgentPlatform)' == 'Windows'">
    <!-- Windows Service hosting belongs to the host: it composes the platform; neither Agent.Core nor the platform project knows the service manager. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgentPlatform)' == 'Windows'">
    <Content Include="../../../deploy/windows/*.ps1" Link="deploy/windows/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../agent/core/BackupPlatform.Agent.Core.csproj" />
    <ProjectReference Include="../../agent/transport/BackupPlatform.Agent.Transport.csproj" />
    <ProjectReference Include="../../agent/platform-windows/BackupPlatform.Agent.Platform.Windows.csproj" Condition="'$(AgentPlatform)' == 'Windows'" />
    <ProjectReference Include="../../agent/platform-linux/BackupPlatform.Agent.Platform.Linux.csproj" Condition="'$(AgentPlatform)' == 'Linux'" />
    <ProjectReference Include="../../providers/backup/mssql/BackupPlatform.BackupProviders.MSSQL.csproj" />
    <ProjectReference Include="../../providers/backup/postgresql/BackupPlatform.BackupProviders.PostgreSql.csproj" />
    <ProjectReference Include="../../providers/backup/file-system/BackupPlatform.BackupProviders.FileSystem.csproj" />
    <ProjectReference Include="../../providers/storage/local/BackupPlatform.StorageProviders.Local.csproj" />
    <ProjectReference Include="../../providers/storage/central/BackupPlatform.StorageProviders.Central.csproj" />
    <ProjectReference Include="../../providers/storage/sftp/BackupPlatform.StorageProviders.Sftp.csproj" />
    <ProjectReference Include="../../providers/storage/google-drive/BackupPlatform.StorageProviders.GoogleDrive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackupPlatform.AgentTests" />
  </ItemGroup>

  <Target Name="ValidateAgentPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AgentPlatform)' != 'Windows' and '$(AgentPlatform)' != 'Linux'" Text="AgentPlatform must be Windows or Linux. Set -p:AgentPlatform explicitly when cross-building." />
  </Target>

  <PropertyGroup>
    <DirectDownloadOs Condition="'$(AgentPlatform)' == 'Windows'">windows</DirectDownloadOs>
    <DirectDownloadOs Condition="'$(AgentPlatform)' == 'Linux'">linux</DirectDownloadOs>
    <DirectDownloadArch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</DirectDownloadArch>
    <DirectDownloadArch Condition="'$(DirectDownloadArch)' == ''">amd64</DirectDownloadArch>
    <DirectDownloadName>backup-direct-download</DirectDownloadName>
    <DirectDownloadName Condition="'$(AgentPlatform)' == 'Windows'">backup-direct-download.exe</DirectDownloadName>
    <DirectDownloadOutput>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)direct/$(DirectDownloadName)</DirectDownloadOutput>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(DirectDownloadOutput)" Link="$(DirectDownloadName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../agent/direct-download/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-DIRECT-DOWNLOAD.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../providers/storage/smb/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-SMBLIBRARY.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildDirectDownloadTransport" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(DirectDownloadOutput)'))" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../agent/direct-download" Command="go build -mod=readonly -trimpath -o &quot;$(DirectDownloadOutput)&quot; ." EnvironmentVariables="GOOS=$(DirectDownloadOs);GOARCH=$(DirectDownloadArch);CGO_ENABLED=0" />
  </Target>
</Project>

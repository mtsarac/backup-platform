<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AgentPlatform Condition="'$(AgentPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</AgentPlatform>
    <AgentPlatform Condition="'$(AgentPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</AgentPlatform>
    <TargetFramework Condition="'$(AgentPlatform)' == 'Windows'">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../agent/core/BackupPlatform.Agent.Core.csproj" />
    <ProjectReference Include="../../agent/platform-windows/BackupPlatform.Agent.Platform.Windows.csproj" Condition="'$(AgentPlatform)' == 'Windows'" />
    <ProjectReference Include="../../agent/platform-linux/BackupPlatform.Agent.Platform.Linux.csproj" Condition="'$(AgentPlatform)' == 'Linux'" />
    <ProjectReference Include="../../providers/backup/mssql/BackupPlatform.BackupProviders.MSSQL.csproj" />
    <ProjectReference Include="../../providers/backup/file-system/BackupPlatform.BackupProviders.FileSystem.csproj" />
    <ProjectReference Include="../../providers/storage/local/BackupPlatform.StorageProviders.Local.csproj" />
    <ProjectReference Include="../../providers/storage/central/BackupPlatform.StorageProviders.Central.csproj" />
  </ItemGroup>

  <Target Name="ValidateAgentPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AgentPlatform)' != 'Windows' and '$(AgentPlatform)' != 'Linux'" Text="AgentPlatform must be Windows or Linux. Set -p:AgentPlatform explicitly when cross-building." />
  </Target>
</Project>

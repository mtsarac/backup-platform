{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backups": {
    "Retention": {
      "Enabled": true,
      "ScanInterval": "00:00:30",
      "BatchSize": 100,
      "MaxBatchesPerCycle": 20,
      "DefaultRetentionEnabled": true,
      "DefaultKeepFor": "30.00:00:00",
      "DefaultDeleteGracePeriod": "1.00:00:00",
      "MinimumKeepFor": "01:00:00",
      "MinimumDeleteGracePeriod": "01:00:00",
      "DeleteLeaseDuration": "00:10:00",
      "DeleteRetryInitialDelay": "00:01:00",
      "DeleteRetryMaxDelay": "01:00:00",
      "StorageSweepEnabled": true,
      "StorageSweepInterval": "01:00:00",
      "OrphanMinimumAge": "06:00:00",
      "PartialUploadMinimumAge": "06:00:00",
      "MaxSweepDeletionsPerRun": 1000,
      "ScheduleOccurrenceHistoryRetention": "90.00:00:00",
      "ScheduleOccurrencePruneInterval": "01:00:00",
      "ScheduleOccurrencePruneBatchSize": 1000
    }
  }
}

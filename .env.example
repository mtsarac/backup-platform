POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres

# One HTTPS port serves the UI, the API, the agent paths and the agent hub (443 in the container). Use 443 to match production.
FRONTEND_PORT=5173
FRONTEND_HTTP_PORT=5174

PUBLIC_HOST=192.168.122.1

BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=PlatformAdmin123!
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test

# Google Drive storage (OAuth web client). Redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:5173/api/platform/google-drive/oauth/callback
GOOGLE_FRONTEND_ORIGIN=https://localhost:5173
